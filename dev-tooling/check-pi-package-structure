#!/usr/bin/env python3
"""check-pi-package-structure — structural gate over this repo's pi package.

The shared `check-skill-invocation-paths` Verifier guards the analogous
invariants for CLAUDE plugins, and it is scoped to `.claude-plugin/skills/`. A
pi package ships its skills at `skills/` instead, so that Verifier VACUOUSLY
SKIPS here — it returns 0 having inspected nothing. This repo-local check is the
pi analogue, so the invariants are actually enforced against the tree that
actually ships.

What it asserts, and why each one is load-bearing:

- **All eight operations, and only those.** The Driver surface is fixed by
  livespec `SPECIFICATION/contracts.md` §"Plugin distribution": seed,
  propose-change, critique, revise, doctor, prune-history, next, help. A missing
  binding is a silently-absent command; an extra one is a surface this repo
  never contracted to expose.
- **Frontmatter conformance.** pi refuses to load a skill with no description
  and warns on a name that breaks the Agent Skills name rules. Both failures are
  quiet at runtime, so they are loud here.
- **No `.claude-plugin/skills/*` reference.** Core intentionally ships no such
  tree; §"pi dogfooding compatibility" forbids a binding from pointing at one.
- **Canonical wrapper invocation.** A fenced line invoking a `bin/<name>.py`
  wrapper must go through `$LIVESPEC_CORE_ROOT`, never `uv run` (the installed
  package has no project to resolve) and never the `.claude-plugin/scripts`
  literal.
- **prune-history stays explicit-invocation only.** The destructive-command
  control from the core prose is preserved by `disable-model-invocation: true`
  plus prose saying so.
- **The pi manifest.** `keywords` carries `pi-package` and the `pi` block names
  the two resource directories, each of which must exist — a manifest naming a
  directory that is not there loads nothing and reports nothing.
- **The footgun guard.** Exactly one `tool_call` registration, all four block
  predicates present, and an internal catch: pi blocks the tool when a
  `tool_call` handler throws, so the contract's fail-open discipline exists only
  if the handler catches its own errors.

Emits a JSON summary on stdout and exits 0 when clean; writes each violation to
stderr and exits 2 otherwise.
"""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path

OPERATIONS = (
    "seed",
    "propose-change",
    "critique",
    "revise",
    "doctor",
    "prune-history",
    "next",
    "help",
)

_NAME_RULES = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
_FENCE = "```"
_WRAPPER_INVOCATION = re.compile(r"bin/[a-z_]+\.py\b")
_CORE_ROOT_TOKEN = re.compile(r"\$\{?LIVESPEC_CORE_ROOT\}?/scripts/bin/[a-z_]+\.py")
_TOOL_CALL_REGISTRATION = re.compile(r'pi\.on\(\s*"tool_call"')

_GUARD_PREDICATES = {
    "--no-verify": "the --no-verify block",
    "LEFTHOOK": "the LEFTHOOK=0/false block",
    "core.bare": "the core.bare=true block",
    "livespec.primaryPath": "the primary-checkout-edit block",
}


def frontmatter(*, text: str) -> dict[str, str]:
    """The `key: value` pairs of a leading `---` fenced YAML block.

    Deliberately not a YAML parser: SKILL.md frontmatter in this package is flat
    scalars only, and depending on a YAML library for eight files would be a new
    dependency guarding nothing.
    """
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}
    fields: dict[str, str] = {}
    for line in lines[1:]:
        if line.strip() == "---":
            break
        key, separator, value = line.partition(":")
        if separator:
            fields[key.strip()] = value.strip()
    return fields


def fenced_invocations(*, text: str) -> list[str]:
    """Stripped in-fence lines that invoke a `bin/<name>.py` wrapper.

    Prose references OUTSIDE fences are narration, not executable command lines,
    and are never gathered — the same fenced-vs-prose distinction the shared
    Claude-side Verifier draws.
    """
    gathered: list[str] = []
    in_fence = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith(_FENCE):
            in_fence = not in_fence
            continue
        if in_fence and _WRAPPER_INVOCATION.search(stripped):
            gathered.append(stripped)
    return gathered


def skill_violations(*, operation: str, path: Path) -> list[str]:
    if not path.is_file():
        return [f"{path}: missing SKILL.md for operation '{operation}'"]
    text = path.read_text(encoding="utf-8")
    found: list[str] = []
    fields = frontmatter(text=text)
    expected_name = f"livespec-{operation}"
    if fields.get("name") != expected_name:
        found.append(f"{path}: frontmatter name is {fields.get('name')!r}, expected {expected_name!r}")
    if not fields.get("description"):
        found.append(f"{path}: frontmatter carries no description (pi will not load the skill)")
    if not _NAME_RULES.match(fields.get("name", "")) or len(fields.get("name", "")) > 64:
        found.append(f"{path}: name {fields.get('name')!r} breaks the Agent Skills name rules")
    if ".claude-plugin/skills" in text:
        found.append(f"{path}: references .claude-plugin/skills/* — core ships no such tree")
    if "lib/resolve-core-root.sh" not in text:
        found.append(f"{path}: does not delegate core-root resolution to lib/resolve-core-root.sh")
    found.extend(_invocation_violations(path=path, text=text))
    if operation == "prune-history":
        found.extend(_prune_history_violations(path=path, text=text, fields=fields))
    return found


def _invocation_violations(*, path: Path, text: str) -> list[str]:
    found: list[str] = []
    for command in fenced_invocations(text=text):
        if "uv run" in command:
            found.append(f"{path}: fenced invocation uses `uv run`: {command}")
        elif ".claude-plugin/scripts" in command:
            found.append(f"{path}: fenced invocation hard-codes .claude-plugin/scripts: {command}")
        elif _CORE_ROOT_TOKEN.search(command) is None:
            found.append(
                f"{path}: fenced invocation lacks the canonical "
                f"$LIVESPEC_CORE_ROOT/scripts/bin/<name>.py token: {command}"
            )
    return found


def _prune_history_violations(*, path: Path, text: str, fields: dict[str, str]) -> list[str]:
    found: list[str] = []
    if fields.get("disable-model-invocation") != "true":
        found.append(f"{path}: prune-history must carry `disable-model-invocation: true`")
    if "explicit user" not in text.lower():
        found.append(f"{path}: prune-history must state that it is explicit-user-invocation only")
    return found


def manifest_violations(*, root: Path) -> list[str]:
    path = root / "package.json"
    if not path.is_file():
        return [f"{path}: missing pi package manifest"]
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except ValueError as invalid:
        return [f"{path}: not valid JSON: {invalid}"]
    found: list[str] = []
    if "pi-package" not in manifest.get("keywords", []):
        found.append(f"{path}: keywords must include 'pi-package'")
    block = manifest.get("pi")
    if not isinstance(block, dict):
        return [*found, f"{path}: carries no `pi` manifest block"]
    for key, expected in (("skills", "./skills"), ("extensions", "./extensions")):
        declared = block.get(key)
        if declared != [expected]:
            found.append(f"{path}: pi.{key} is {declared!r}, expected {[expected]!r}")
            continue
        if not (root / expected).is_dir():
            found.append(f"{path}: pi.{key} names {expected}, which does not exist")
    return found


def extension_violations(*, root: Path) -> list[str]:
    path = root / "extensions" / "livespec-footgun-guard.ts"
    if not path.is_file():
        return [f"{path}: missing the sanctioned tool_call footgun-guard extension"]
    text = path.read_text(encoding="utf-8")
    found: list[str] = []
    registrations = len(_TOOL_CALL_REGISTRATION.findall(text))
    if registrations != 1:
        found.append(f"{path}: registers {registrations} tool_call handlers, expected exactly 1")
    for token, description in _GUARD_PREDICATES.items():
        if token not in text:
            found.append(f"{path}: no sign of {description} (token {token!r} absent)")
    if "catch" not in text:
        found.append(f"{path}: no internal catch — pi fails CLOSED, so the guard must catch its own errors")
    return found


def resolver_violations(*, root: Path) -> list[str]:
    path = root / "lib" / "resolve-core-root.sh"
    if not path.is_file():
        return [f"{path}: missing the shared core-root resolver"]
    if not path.stat().st_mode & 0o111:
        return [f"{path}: is not executable"]
    return []


def violations(*, root: Path) -> list[str]:
    found: list[str] = []
    skills_root = root / "skills"
    for operation in OPERATIONS:
        found.extend(
            skill_violations(operation=operation, path=skills_root / f"livespec-{operation}" / "SKILL.md")
        )
    expected = {f"livespec-{operation}" for operation in OPERATIONS}
    if skills_root.is_dir():
        for entry in sorted(skills_root.iterdir()):
            if entry.is_dir() and entry.name not in expected:
                found.append(f"{entry}: undeclared skill — the Driver surface is the eight operations")
    found.extend(resolver_violations(root=root))
    found.extend(manifest_violations(root=root))
    found.extend(extension_violations(root=root))
    return found


def main() -> int:
    root = Path.cwd()
    found = violations(root=root)
    if found:
        for violation in found:
            sys.stderr.write(f"pi-package-structure: {violation}\n")
        return 2
    sys.stdout.write(
        json.dumps(
            {"check_id": "pi-package-structure-ok", "skills": len(OPERATIONS)},
            sort_keys=True,
        )
        + "\n"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
